{
  "name": "cobaltcounsel.com",
  "private": true,
  "description": "Cobaltcounsel.com public site",
  "version": "0.0.1",
  "author": "Joshua Koudys <josh@clausehound.com>",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "prettier": "^3.6.0"
  },
  "license": "MIT",
  "scripts": {
    "build": "eleventy",
    "build:js": "esbuild src/ts/main.ts --bundle --minify --target=es2020 --outfile=public/js/main.js",
    "develop": "eleventy --serve",
    "start": "npm run develop",
    "typecheck": "tsc",
    "format": "prettier --write \"src/**/*.{ts,css,json}\""
  },
  "engines": {
    "node": ">=22"
  }
}
